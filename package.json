{
  "name": "ccodex-studio",
  "version": "0.1.0",
  "description": "Codex-style desktop workbench for Claude Code and Agent Skills",
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": "https://github.com/junru-a/ccodex-studio.git"
  },
  "keywords": [
    "claude-code",
    "deepseek",
    "electron",
    "agent-skills",
    "codex"
  ],
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:renderer": "node scripts/dev-renderer.js",
    "dev:electron": "wait-on http://localhost:9000 && tsc -p tsconfig.electron.json && electron .",
    "build:renderer": "webpack --config webpack.renderer.config.js --mode production",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:renderer && npm run build:electron",
    "prepublish:check": "node scripts/prepublish-check.js",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "katex": "^0.17.0",
    "node-pty": "^1.0.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "concurrently": "^8.2.2",
    "css-loader": "^6.10.0",
    "electron": "^35.7.5",
    "electron-builder": "^26.8.1",
    "html-webpack-plugin": "^5.6.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "style-loader": "^3.3.4",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.3",
    "wait-on": "^7.2.0",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.4"
  },
  "build": {
    "appId": "com.ccodex.studio",
    "productName": "CCodex Studio",
    "files": [
      "dist-electron/**/*",
      "dist-renderer/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    }
  }
}
